{
  "name": "main",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:daily-study": "node --experimental-strip-types --test tests/daily-study.test.mjs tests/pathways.test.mjs tests/reviews.test.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:knowledge": "node --experimental-strip-types --test tests/study-content.test.mjs tests/reviews.test.mjs tests/multiple-choice.test.mjs tests/concepts.test.mjs tests/pathways.test.mjs tests/java-foundations.test.mjs tests/java-types-depth.test.mjs tests/java-types-depth-2.test.mjs tests/java-control-flow-depth.test.mjs tests/java-control-flow-depth-2.test.mjs tests/java-control-flow-progression.test.mjs tests/learning-order.test.mjs tests/daily-study.test.mjs",
    "seed:java:foundations": "node scripts/build-java-foundations-seed.mjs",
    "verify:java:foundations": "node scripts/verify-java-foundations.mjs",
    "preview": "vite preview",
    "seed:java:types-depth": "node scripts/build-java-types-depth-seed.mjs",
    "verify:java:types-depth": "node scripts/verify-java-foundations.mjs --pack=cards/pathways/java_types_depth_1.json",
    "seed:java:types-depth-2": "node scripts/build-java-types-depth-seed.mjs --pack=cards/pathways/java_types_depth_2.json --output=supabase/seeds/java_types_depth_2.sql",
    "verify:java:types-depth-2": "node scripts/verify-java-foundations.mjs --pack=cards/pathways/java_types_depth_2.json",
    "seed:java:control-flow": "node scripts/build-java-control-flow-seed.mjs",
    "verify:java:control-flow": "node scripts/verify-java-foundations.mjs --pack=cards/pathways/java_control_flow_depth_1.json",
    "test:java:control-flow": "node --experimental-strip-types --test tests/java-control-flow-depth.test.mjs",
    "seed:java:control-flow-2": "node scripts/build-java-control-flow-seed.mjs --pack=cards/pathways/java_control_flow_depth_2.json --output=supabase/seeds/java_control_flow_depth_2.sql",
    "verify:java:control-flow-2": "node scripts/verify-java-foundations.mjs --pack=cards/pathways/java_control_flow_depth_2.json",
    "test:java:control-flow-2": "node --experimental-strip-types --test tests/java-control-flow-depth-2.test.mjs",
    "seed:java:control-flow-progression": "node scripts/build-java-control-flow-seed.mjs --pack=cards/pathways/java_control_flow_progression_1.json --output=supabase/seeds/java_control_flow_progression_1.sql",
    "verify:java:control-flow-progression": "node scripts/verify-java-foundations.mjs --pack=cards/pathways/java_control_flow_progression_1.json",
    "test:java:control-flow-progression": "node --experimental-strip-types --test tests/java-control-flow-progression.test.mjs tests/learning-order.test.mjs tests/daily-study.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "dexie": "^4.4.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
